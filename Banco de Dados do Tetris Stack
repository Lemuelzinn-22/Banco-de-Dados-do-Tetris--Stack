#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define TAM_FILA 5
#define TAM_PILHA 3

// Estrutura que representa uma peça do Tetris
typedef struct {
    char nome;  // tipo da peça ('I', 'O', 'T', 'L')
    int id;     // identificador único
} Peca;

// Estrutura de fila circular
typedef struct {
    Peca elementos[TAM_FILA];
    int inicio, fim, tamanho;
} Fila;

// Estrutura de pilha
typedef struct {
    Peca elementos[TAM_PILHA];
    int topo;
} Pilha;

// --- Protótipos das funções ---
void inicializarFila(Fila *f);
void inicializarPilha(Pilha *p);
int filaCheia(Fila *f);
int filaVazia(Fila *f);
int pilhaCheia(Pilha *p);
int pilhaVazia(Pilha *p);
void enfileirar(Fila *f, Peca p);
Peca desenfileirar(Fila *f);
void empilhar(Pilha *p, Peca p);
Peca desempilhar(Pilha *p);
void exibirEstado(Fila *f, Pilha *p);
Peca gerarPeca();
void trocarPecaTopoFila(Fila *f, Pilha *p);
void trocarMultiplas(Fila *f, Pilha *p);

// --- Função principal ---
int main() {
    srand(time(NULL));

    Fila fila;
    Pilha pilha;
    inicializarFila(&fila);
    inicializarPilha(&pilha);

    int opcao;
    Peca removida;
    
    printf("\n=== GERENCIADOR DE PEÇAS - TETRIS STACK (NÍVEL AVANÇADO) ===\n");

    do {
        exibirEstado(&fila, &pilha);

        printf("\nOpções disponíveis:\n");
        printf("1 - Jogar peça da frente da fila\n");
        printf("2 - Reservar peça (mover da fila para a pilha)\n");
        printf("3 - Usar peça reservada (remover do topo da pilha)\n");
        printf("4 - Trocar peça da frente da fila com o topo da pilha\n");
        printf("5 - Trocar os 3 primeiros da fila com as 3 da pilha\n");
        printf("0 - Sair\n");
        printf("\nOpção escolhida: ");
        scanf("%d", &opcao);

        switch(opcao) {
            case 1:
                if (!filaVazia(&fila)) {
                    removida = desenfileirar(&fila);
                    printf("\nPeça jogada: [%c %d]\n", removida.nome, removida.id);
                    enfileirar(&fila, gerarPeca());
                } else {
                    printf("\nFila vazia! Nenhuma peça para jogar.\n");
                }
                break;

            case 2:
                if (pilhaCheia(&pilha)) {
                    printf("\nPilha cheia! Não é possível reservar mais peças.\n");
                } else if (filaVazia(&fila)) {
                    printf("\nFila vazia! Nenhuma peça para mover.\n");
                } else {
                    removida = desenfileirar(&fila);
                    empilhar(&pilha, removida);
                    printf("\nPeça [%c %d] movida para reserva.\n", removida.nome, removida.id);
                    enfileirar(&fila, gerarPeca());
                }
                break;

            case 3:
                if (!pilhaVazia(&pilha)) {
                    removida = desempilhar(&pilha);
                    printf("\nPeça reservada usada: [%c %d]\n", removida.nome, removida.id);
                } else {
                    printf("\nPilha vazia! Nenhuma peça para usar.\n");
                }
                break;

            case 4:
                trocarPecaTopoFila(&fila, &pilha);
                break;

            case 5:
                trocarMultiplas(&fila, &pilha);
                break;

            case 0:
                printf("\nEncerrando o programa...\n");
                break;

            default:
                printf("\nOpção inválida! Tente novamente.\n");
        }

    } while (opcao != 0);

    return 0;
}

// --- Implementações das funções ---

void inicializarFila(Fila *f) {
    f->inicio = 0;
    f->fim = 0;
    f->tamanho = 0;

    for (int i = 0; i < TAM_FILA; i++)
        enfileirar(f, gerarPeca());
}

void inicializarPilha(Pilha *p) {
    p->topo = -1;
}

int filaCheia(Fila *f) {
    return f->tamanho == TAM_FILA;
}

int filaVazia(Fila *f) {
    return f->tamanho == 0;
}

int pilhaCheia(Pilha *p) {
    return p->topo == TAM_PILHA - 1;
}

int pilhaVazia(Pilha *p) {
    return p->topo == -1;
}

void enfileirar(Fila *f, Peca p) {
    if (!filaCheia(f)) {
        f->elementos[f->fim] = p;
        f->fim = (f->fim + 1) % TAM_FILA;
        f->tamanho++;
    }
}

Peca desenfileirar(Fila *f) {
    Peca p = {'-', -1};
    if (!filaVazia(f)) {
        p = f->elementos[f->inicio];
        f->inicio = (f->inicio + 1) % TAM_FILA;
        f->tamanho--;
    }
    return p;
}

void empilhar(Pilha *p, Peca pec) {
    if (!pilhaCheia(p))
        p->elementos[++p->topo] = pec;
}

Peca desempilhar(Pilha *p) {
    Peca pec = {'-', -1};
    if (!pilhaVazia(p))
        pec = p->elementos[p->topo--];
    return pec;
}

void exibirEstado(Fila *f, Pilha *p) {
    printf("\n------------------------------\n");
    printf("Fila de peças: ");
    for (int i = 0; i < f->tamanho; i++) {
        int index = (f->inicio + i) % TAM_FILA;
        printf("[%c %d] ", f->elementos[index].nome, f->elementos[index].id);
    }

    printf("\nPilha de reserva (Topo -> Base): ");
    for (int i = p->topo; i >= 0; i--) {
        printf("[%c %d] ", p->elementos[i].nome, p->elementos[i].id);
    }
    printf("\n------------------------------\n");
}

Peca gerarPeca() {
    static int contador = 0;
    char tipos[] = {'I', 'O', 'T', 'L'};
    Peca p;
    p.nome = tipos[rand() % 4];
    p.id = contador++;
    return p;
}

void trocarPecaTopoFila(Fila *f, Pilha *p) {
    if (filaVazia(f) || pilhaVazia(p)) {
        printf("\nNão é possível realizar a troca (fila ou pilha vazia).\n");
        return;
    }

    int indiceFrente = f->inicio;
    Peca temp = f->elementos[indiceFrente];
    f->elementos[indiceFrente] = p->elementos[p->topo];
    p->elementos[p->topo] = temp;

    printf("\nTroca entre a peça da frente da fila e o topo da pilha realizada com sucesso!\n");
}

void trocarMultiplas(Fila *f, Pilha *p) {
    if (f->tamanho < 3 || p->topo < 2) {
        printf("\nNão há peças suficientes para troca múltipla!\n");
        return;
    }

    for (int i = 0; i < 3; i++) {
        int indiceFila = (f->inicio + i) % TAM_FILA;
        Peca temp = f->elementos[indiceFila];
        f->elementos[indiceFila] = p->elementos[p->topo - i];
        p->elementos[p->topo - i] = temp;
    }

    printf("\nTroca múltipla entre as 3 primeiras da fila e as 3 da pilha concluída!\n");
}
